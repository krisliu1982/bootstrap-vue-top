{
  "name": "bootstrap-vue-ui",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "BootstrapVue 是一个基于 Bootstrap & Vue 的前端框架。",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/bootstrap-vue.cjs",
  "module": "./dist/bootstrap-vue.js",
  "exports": {
    ".": {
      "import": "./dist/bootstrap-vue.js",
      "require": "./dist/bootstrap-vue.cjs"
    },
    "./style.css": "./dist/bootstrap-vue.css",
    "./editor": {
      "import": "./dist/bootstrap-vue-editor.js",
      "require": "./dist/bootstrap-vue-editor.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.{js,vue,ts,json}\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tiptap/core": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "bootstrap": "^5.3.8",
    "focus-trap": "^6.9.4",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "autoprefixer": "^10.4.27",
    "prettier": "^3.8.2",
    "sass": "^1.99.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.0.8",
    "vue": "^3.5.32"
  },
  "keywords": [
    "boostrap5",
    "vue3",
    "ui-library"
  ],
  "author": "kris.liu",
  "license": "MIT"
}
