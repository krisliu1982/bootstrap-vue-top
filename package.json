{
  "name": "bootstrap-vue-top",
  "version": "2.0.0",
  "homepage": "https://bootstrap-vue.top",
  "private": false,
  "type": "module",
  "description": "A frontend framework based on Bootstrap & Vue.",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "main": "./dist/bootstrap-vue-top.umd.cjs",
  "module": "./dist/bootstrap-vue-top.js",
  "exports": {
    ".": {
      "import": "./dist/bootstrap-vue-top.js",
      "require": "./dist/bootstrap-vue-top.umd.cjs"
    },
    "./style.css": "./dist/bootstrap-vue-top.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.{js,vue,ts,json}\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "bootstrap": "^6.0.0-alpha.1",
    "focus-trap": "^8.2.3",
    "lodash-es": "^4.18.1",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  },
  "keywords": [
    "bootstrap",
    "vue",
    "ui",
    "ES6",
    "javascript"
  ],
  "author": "kris.liu",
  "license": "MIT"
}
