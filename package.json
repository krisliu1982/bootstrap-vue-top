{
  "name": "bootstrap-vue-top",
  "version": "5.3.9",
  "homepage": "https://bootstrap-vue.top",
  "private": false,
  "type": "module",
  "description": "bootstrap-vue-top is a Vue extension for Bootstrap.",
  "files": [
    "dist",
    "src",
    "docs",
    ".browserslistrc",
    "package.json",
    "postcss.config.js",
    "README.md",
    "LICENSE",
    "vite.config.js"
  ],
  "main": "./dist/bootstrap-vue-top.umd.cjs",
  "module": "./dist/bootstrap-vue-top.js",
  "exports": {
    ".": {
      "import": "./dist/bootstrap-vue-top.js",
      "require": "./dist/bootstrap-vue-top.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.{js,vue,ts,json}\"",
    "lint": "eslint --ext .js,.vue src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/bi": "^1.2.7",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.3.9",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  },
  "keywords": [
    "bootstrap",
    "vue",
    "ui",
    "ES6",
    "js"
  ],
  "author": "kris.liu",
  "license": "MIT"
}
