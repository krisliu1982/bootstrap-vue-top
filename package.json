{
  "name": "bootstrap-vue-top",
  "version": "1.0.1",
  "homepage": "https://bootstrap-vue.top",
  "private": false,
  "type": "module",
  "description": "bootstrap-vue-top 是一个基于 Bootstrap 5 & Vue 3 的前端框架。",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/bootstrap-vue.umd.cjs",
  "module": "./dist/bootstrap-vue.js",
  "exports": {
    ".": {
      "import": "./dist/bootstrap-vue.js",
      "require": "./dist/bootstrap-vue.umd.cjs"
    },
    "./style.css": "./dist/bootstrap-vue.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.{js,vue,ts,json}\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "focus-trap": "^6.9.4",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^8.2.1",
    "vue": "^3.5.41"
  },
  "keywords": [
    "boostrap 5.3.8",
    "vue 3.5.41",
    "ES6",
    "ui library"
  ],
  "author": "kris.liu",
  "license": "MIT"
}
